# Database (PostgreSQL via Neon / Supabase)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Authentification (Argon2id, Session JWT/Cookie secret)
AUTH_SECRET="generate-with-openssl-rand-hex-32"

# Chiffrement symétrique des secrets applicatifs (AES-256-GCM : clé hex 32 octets / 64 car)
ENCRYPTION_KEY="generate-64-hex-characters-key"

# Emails transactionnels (Resend)
RESEND_API_KEY="re_xxxxxxxxxxxx"
EMAIL_FROM="LGV SaaS <noreply@gerantvirtuel.bj>"

# Passerelle de paiement FedaPay (Bénin)
FEDAPAY_SECRET_KEY="sk_live_or_test_xxxx"
FEDAPAY_WEBHOOK_SECRET="wh_live_or_test_xxxx"
FEDAPAY_ENV="sandbox" # ou "live"
NEXT_PUBLIC_FEDAPAY_PUBLIC_KEY="pk_live_or_test_xxxx"

# Anti-abus et limitation de débit (Upstash Redis)
UPSTASH_REDIS_REST_URL="https://xxxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="xxxx"

# Stockage privé des pièces jointes et logos (Vercel Blob ou Cloudflare R2)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxx"

# Observabilité Sentry
SENTRY_DSN="https://xxxx@sentry.io/xxxx"

# URL de l'application
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
